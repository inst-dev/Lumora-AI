# ====================================================
# LUMORA AI - Git Ignore Configuration
# ====================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files - NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep .env.example for reference
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo

# Uploads
/public/uploads/*
!/public/uploads/.gitkeep

# Logs
/logs
*.log
