# ====================================================
# LUMORA AI - Environment Configuration
# ====================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ====================================================
# APPLICATION SETTINGS
# ====================================================
NEXT_PUBLIC_APP_NAME="Lumora AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0
APP_SECRET_KEY=your-random-secret-key-min-32-chars
APP_ENVIRONMENT=development

# ====================================================
# DATABASE (MySQL)
# ====================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lumora_ai
DB_USER=root
DB_PASSWORD=your-database-password

# ====================================================
# AUTHENTICATION
# ====================================================
JWT_SECRET=your-jwt-secret-key-min-64-chars
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d
SESSION_COOKIE_NAME=lumora_session

# ====================================================
# AI PROVIDERS
# ====================================================
# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude
CLAUDE_API_KEY=your-claude-api-key

# xAI Grok
GROK_API_KEY=your-grok-api-key

# ====================================================
# PAYMENT GATEWAYS
# ====================================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# PayHere (Sri Lanka)
PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_MERCHANT_SECRET=your-merchant-secret
PAYHERE_MODE=sandbox

# Paddle
PADDLE_VENDOR_ID=your-paddle-vendor-id
PADDLE_API_KEY=your-paddle-api-key

# LemonSqueezy
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id

# ====================================================
# EMAIL (SMTP)
# ====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_NAME="Lumora AI"
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ====================================================
# ENVATO LICENSE VERIFICATION
# ====================================================
ENVATO_PERSONAL_TOKEN=your-envato-personal-token
ENVATO_ITEM_ID=your-envato-item-id
LICENSE_API_URL=https://api.envato.com/v3/market/author/sale

# ====================================================
# FILE UPLOADS
# ====================================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# ====================================================
# RATE LIMITING
# ====================================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ====================================================
# SECURITY
# ====================================================
CSRF_SECRET=your-csrf-secret-key
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ====================================================
# INSTALLATION STATUS
# ====================================================
INSTALLED=false
